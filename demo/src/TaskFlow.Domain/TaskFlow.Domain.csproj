<Project Sdk="Microsoft.NET.Sdk">

  <!-- Use local project references for development/testing fixes -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ErikLieben.FA.ES\ErikLieben.FA.ES.csproj" />
    <ProjectReference Include="..\..\..\src\ErikLieben.FA.ES.AzureStorage\ErikLieben.FA.ES.AzureStorage.csproj" />
    <ProjectReference Include="..\..\..\src\ErikLieben.FA.ES.CosmosDb\ErikLieben.FA.ES.CosmosDb.csproj" />
    <ProjectReference Include="..\..\..\src\ErikLieben.FA.ES.S3\ErikLieben.FA.ES.S3.csproj" />
    <PackageReference Include="ErikLieben.FA.ES.Analyzers" Version="2.0.0-preview.6">
